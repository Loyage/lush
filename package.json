{
  "name": "lush-runtime",
  "version": "0.2.0",
  "description": "Project-scoped, non-blocking multi-agent development",
  "type": "module",
  "private": true,
  "bin": { "lush": "./bin/lush", "lushd": "./bin/lushd", "lush-web": "./bin/lush-web" },
  "exports": { ".": "./src/index.js" },
  "scripts": {
    "test": "bun test",
    "lush": "bun ./bin/lush",
    "lushd": "bun ./bin/lushd",
    "help": "bun ./scripts/ops.js help",
    "doctor": "bun ./scripts/ops.js doctor",
    "start": "bun ./scripts/ops.js start",
    "stop": "bun ./scripts/ops.js stop",
    "daemon-start": "bun ./scripts/ops.js daemon-start",
    "daemon-stop": "bun ./scripts/ops.js daemon-stop",
    "daemon-restart": "bun ./scripts/ops.js daemon-restart",
    "status": "bun ./scripts/ops.js status",
    "log": "bun ./scripts/ops.js log",
    "web": "bun ./scripts/ops.js web",
    "say": "bun ./scripts/ops.js say",
    "draft": "bun ./scripts/ops.js draft",
    "drafts": "bun ./scripts/ops.js drafts",
    "intent": "bun ./scripts/ops.js intent",
    "intents": "bun ./scripts/ops.js intents",
    "tasks": "bun ./scripts/ops.js tasks",
    "tree": "bun ./scripts/ops.js tree",
    "inspect": "bun ./scripts/ops.js inspect",
    "message": "bun ./scripts/ops.js message",
    "cancel": "bun ./scripts/ops.js cancel",
    "retry": "bun ./scripts/ops.js retry",
    "wait": "bun ./scripts/ops.js wait",
    "merge": "bun ./scripts/ops.js merge",
    "cleanup": "bun ./scripts/ops.js cleanup",
    "notices": "bun ./scripts/ops.js notices",
    "answer": "bun ./scripts/ops.js answer"
  },
  "engines": { "bun": ">=1.2.0" }
}
