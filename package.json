{
  "name": "lush-runtime",
  "version": "0.2.0",
  "description": "Project-scoped, non-blocking multi-agent development",
  "type": "module",
  "private": true,
  "bin": { "lush": "./bin/lush", "lushw": "./bin/lushw", "lush-host": "./bin/lush-host", "lushd": "./bin/lushd", "lush-agent-guard": "./bin/lush-agent-guard" },
  "exports": { ".": "./src/index.js" },
  "scripts": {
    "test": "bun test --parallel=4 --timeout=20000",
    "test:serial": "bun test --timeout=20000",
    "test:all": "bun test --parallel=4 --timeout=20000",
    "test:integration": "bun ./scripts/test-integration.js",
    "docs:check": "bun ./scripts/docs-check.js",
    "check:workbench": "bun ./scripts/check-workbench.js",
    "check:agent-layout": "bun ./scripts/check-agent-layout.js",
    "check:model-choice": "bun ./test/web/check-model-choice-browser.js",
    "check:device-settings": "bun ./test/web/check-device-settings.js",
    "measure:read-performance": "bun ./scripts/measure-read-performance.js",
    "lush": "bun ./bin/lush",
    "lushw": "bun ./bin/lushw",
    "lushd": "bun ./bin/lushd",
    "lush-host": "bun ./bin/lush-host"
  },
  "engines": { "bun": ">=1.2.0" }
}
