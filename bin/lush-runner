#!/usr/bin/env bun
import { runRunner } from '../src/runner/index.js';
import { publicError } from '../src/runner/protocol.js';

const args = process.argv.slice(2);
if (args.length === 1 && ['--help', '-h'].includes(args[0])) {
  console.log('lush-runner serve\nUses the node-user provisioned private configuration; no installation or system configuration is performed.');
} else if (args.length !== 1 || args[0] !== 'serve') {
  console.error('Usage: lush-runner serve');
  process.exitCode = 2;
} else {
  try { await runRunner(); }
  catch (error) { console.error(JSON.stringify(publicError(error))); process.exitCode = 1; }
}
